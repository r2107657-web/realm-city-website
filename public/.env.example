# انسخ هذا الملف باسم .env وعبّي القيم الحقيقية
# (لو تستضيف على Railway، أغلب هذي القيم بتوفرها لك تلقائيًا لما تضيف MySQL)

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# رابط الويب هوك اللي تسويه من إعدادات القناة بالديسكورد
DISCORD_WEBHOOK_URL=

# مفتاح تشفير الجلسات — اكتب أي نص عشوائي طويل (30+ حرف)، ما يحتاج يكون له معنى
JWT_SECRET=

# بيانات حساب الأونر الأول — يتنشئ تلقائيًا أول ما السيرفر يشتغل
# بعد أول تشغيل تقدر تحذف هذين السطرين أو تسيبهم، ما يأثر لأنه يتفحص بس أول مرة
OWNER_EMAIL=
OWNER_PASSWORD=

PORT=3000
